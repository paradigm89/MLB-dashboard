# Copy this file to .env and fill in values before running docker compose.
# Never commit .env to git.

# PostgreSQL password (used by docker-compose)
DB_PASSWORD=changeme

# URL for the backend API (used by the frontend)
# When running via docker compose locally, leave as-is.
# On Railway, this will be the Railway-assigned backend URL.
BACKEND_URL=http://localhost:8000

# Optional: Open-Meteo is free, no key needed.
# If you add a paid weather API in the future, set the key here.
# WEATHER_API_KEY=

# Optional: override the database URL directly (bypasses DB_PASSWORD)
# DATABASE_URL=postgresql://mlb:changeme@localhost:5432/mlb
